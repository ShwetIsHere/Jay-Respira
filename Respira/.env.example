# Shared project environment variables
# Copy this file to .env and fill in real values as needed.

# Python risk model API
RISK_MODEL_PATH=../model/respira_random_forest.pkl
RISK_MODEL_MEDIUM_THRESHOLD=0.5
RISK_MODEL_HIGH_THRESHOLD=0.8

# Expo/React Native app
EXPO_PUBLIC_RISK_MODEL_API_URL=http://10.30.203.52:8000
# Native Maps SDK key, injected by mobile/app.config.js for a development build.
GOOGLE_MAPS_API_KEY=replace_with_a_restricted_google_maps_key

# Optional: production deployment configuration
# Use a trusted backend domain behind HTTPS and access controls.
# EXPO_PUBLIC_RISK_MODEL_API_URL=https://risk.example.com
